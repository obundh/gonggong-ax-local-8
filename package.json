{
  "name": "recovery-chat-desktop",
  "version": "0.6.1",
  "private": true,
  "description": "공공 AX 로컬 시리즈 8 - 파일 복구",
  "author": "Recovery Chat",
  "license": "UNLICENSED",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "build:win": "npm run build:native && electron-builder --win zip --x64",
    "test:engine": "node --test test/*.test.mjs",
    "engine": "node engine/cli.mjs",
    "fixture:ntfs": "node test/ntfs-fixtures.mjs",
    "demo:engine": "node scripts/demo-engine.mjs",
    "progress": "node scripts/progress.mjs",
    "build:native": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-native.ps1",
    "test:desktop": "node --test --test-concurrency=1 test/electron-dual-mode.mjs test/electron-period-first.mjs test/electron-workspace.mjs test/electron-stage2.mjs test/electron-stage4.mjs test/electron-recycle-metadata.mjs test/electron-directory-slack.mjs test/electron-hwp-carving.mjs test/electron-deep-coverage.mjs test/electron-deep-resume.mjs test/electron-recent-priority.mjs test/electron-stage5.mjs test/electron-earlier-capture.mjs test/electron-partial-zip.mjs test/electron-autosave.mjs test/electron-recent-traces.mjs"
  },
  "build": {
    "appId": "local.recoverychat.desktop",
    "productName": "공공 AX 로컬 시리즈 8 - 파일 복구",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "styles.css",
      "workspace.css",
      "ui/**",
      "app.js",
      "favicon.svg",
      "electron/main.cjs",
      "electron/preload.cjs",
      "electron/icon.ico",
      "electron/icon.png",
      "assets/brand/**",
      "package.json",
      "engine/**",
      "native/bin/**",
      "native/*.md",
      "README.md",
      "SUPPORT.md",
      "THIRD_PARTY_NOTICES.md",
      "licenses/**"
    ],
    "asar": true,
    "win": {
      "target": "zip",
      "icon": "electron/icon.ico",
      "signExecutable": false,
      "requestedExecutionLevel": "asInvoker"
    },
    "asarUnpack": [
      "engine/**",
      "native/bin/**"
    ],
    "artifactName": "RecoveryChat-${version}-win-x64.${ext}",
    "extraResources": [
      {
        "from": "native/bin/RecoveryChat.VolumeReader.exe",
        "to": "app.asar.unpacked/native/bin/RecoveryChat.VolumeReader.exe"
      }
    ],
    "extraFiles": [
      { "from": "docs/deep-resume-0.6.1.md", "to": "docs/deep-resume-0.6.1.md" },
      {
        "from": "docs/resource-research-0.6.0.md",
